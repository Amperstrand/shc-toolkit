#!/bin/bash
# NoDNS certbot auth hook — publishes _acme-challenge TXT via Nostr kind 11111
set -e

source /opt/nodns-venv/bin/activate

# nostr-sdk 0.45: Keys.parse / async Client / EventBuilder(kind, content).tags /
# finalize_unsigned + keys.sign_event (from_bech32 + sign_with_keys are gone).
python3 -c "
import asyncio, json, sys, time
from nostr_sdk import Client, EventBuilder, Keys, Kind, RelayUrl, Tag

NSEC_FILE = '{{ certbot_nsec_path }}'
ZONE = '{{ nodns_zone }}'
DOMAIN = '${CERTBOT_DOMAIN}'
VALIDATION = '${CERTBOT_VALIDATION}'

with open(NSEC_FILE) as f:
    nsec = f.read().strip()

keys = Keys.parse(nsec)

record = json.dumps([{
    'type': 'TXT',
    'name': '_acme-challenge',
    'value': VALIDATION,
    'ttl': 120,
}])

tags = [
    Tag.parse(['d', DOMAIN]),
    Tag.parse(['t', 'dns']),
    Tag.parse(['zone', ZONE]),
]

unsigned = EventBuilder(Kind(11111), record).tags(tags).finalize_unsigned(keys.public_key())
event = keys.sign_event(unsigned)


async def publish():
    client = Client()
    for url in ('wss://relay.cashu.email', 'wss://nos.lol'):
        try:
            await client.add_relay(RelayUrl.parse(url))
        except Exception as e:
            print(f'relay {url} failed: {e}', file=sys.stderr)
    await client.connect()
    await client.send_event(event)


asyncio.run(publish())
print(f'Published _acme-challenge TXT for {DOMAIN}', file=sys.stderr)

time.sleep(15)
"

echo "NoDNS auth hook complete" >&2
