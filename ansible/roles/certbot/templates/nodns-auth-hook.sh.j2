#!/bin/bash
# NoDNS certbot auth hook — publishes _acme-challenge TXT via Nostr kind 11111
set -e

source /opt/nodns-venv/bin/activate

# nostr-sdk 0.45 + the toolkit's PROVEN record shape: kind 11111 with
# 11-element "record" TAGS (build_record_tag format — "maximum compatibility
# with deployed nodns bots"); the old JSON-in-content shape was never
# materialized by the bot (CA found no TXT, e2e 2026-09-10 layer 12).
python3 -c "
import asyncio, sys, time
from nostr_sdk import Client, EventBuilder, Keys, Kind, RelayUrl, Tag

NSEC_FILE = '{{ certbot_nsec_path }}'
DOMAIN = '${CERTBOT_DOMAIN}'
VALIDATION = '${CERTBOT_VALIDATION}'

with open(NSEC_FILE) as f:
    keys = Keys.parse(f.read().strip())

tags = [
    # 11-element record tag, exactly shc_toolkit.nodns.build_record_tag
    Tag.parse(['record', 'TXT', '_acme-challenge', VALIDATION,
               '', '', '', '', '', '', '120']),
    Tag.parse(['d', DOMAIN]),
    Tag.parse(['t', 'dns']),
]

unsigned = EventBuilder(Kind(11111), '').tags(tags).finalize_unsigned(keys.public_key())
event = keys.sign_event(unsigned)


async def publish():
    client = Client()
    for url in ('wss://relay.cashu.email', 'wss://nos.lol'):
        try:
            await client.add_relay(RelayUrl.parse(url))
        except Exception as e:
            print(f'relay {url} failed: {e}', file=sys.stderr)
    await client.connect()
    await client.send_event(event)


asyncio.run(publish())
print(f'Published _acme-challenge TXT for {DOMAIN}', file=sys.stderr)

time.sleep(15)
"

echo "NoDNS auth hook complete" >&2
